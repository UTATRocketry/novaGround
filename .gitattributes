# Shell scripts and systemd units MUST keep LF endings. A CRLF shebang fails on
# the Pi with "bad interpreter: No such file or directory", and a CRLF unit file
# fails with an unhelpful parse error -- both are painful to diagnose in the
# field. This holds regardless of a contributor's core.autocrlf setting.
*.sh        text eol=lf
*.service   text eol=lf
*.env       text eol=lf

# Build and config files that also get read on Linux.
meson.build text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf

# Binary assets: never touch these.
*.jpg       binary
*.png       binary
*.deb       binary
