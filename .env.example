# Use this file as a reference environment configuration for novaGround.
# Don't copy this file directly; it is only for reference. The actual files are written by nova-pi.sh.
# =============================================================================
# /etc/nova/pi.env example
# =============================================================================
# Which Pi this is and which binary it runs. Written by nova-pi.sh install;
# NOVA_PI_NAME must match this Pi's name in ops/nova.settings.ps1 on the ops server.
NOVA_PI_NAME=NovaGround
NOVA_TARGET=novaGround

# Flags for this Pi's binary in every environment, e.g. "--verbosity 2".
#NOVA_GLOBAL_ARGS=

# =============================================================================
# /etc/nova/novaGround-<env>.env example
# =============================================================================
NOVA_BROKER=192.168.137.1:1883
NOVA_BACKEND=192.168.137.1:8000
NOVA_CONSOLE=192.168.137.1:8080

# Log detail: 0 quiet, 1 info, 2 debug.
NOVA_VERBOSITY=1

# DAQ sampling interval in ms.
#NOVA_SAMPLE_MS=

# Telemetry publish interval in ms.
#NOVA_PUBLISH_MS=

# Runtime instrumentation: on or off.
#NOVA_STATS=on
#NOVA_STATS_MS=1000

# Allow bench-safety flags such as --stop-actuate (on or off). start.sh and run.sh refuse them when off.
NOVA_BENCH_FLAGS=off

# Scenario file for the simulated hardware (novaMock).
#NOVA_SIM_SCENARIO=

# Where novaGround keeps last_upload.json (default /var/lib/nova/<env>).
#NOVA_STATE_DIR=

# More flags for this environment only; they come after NOVA_GLOBAL_ARGS in pi.env.
#NOVA_EXTRA_ARGS=
